@model IEnumerable<IGrouping<char, Lab_rab_3._0_KhasanovaNG_BPI_23_01.Models.Vegetable>>

<h2>Овощи, сгруппированные по первой букве</h2>

@foreach (var group in Model)
{
    <h3>@group.Key</h3>
    <ul>
        @foreach (var item in group)
        {
            <li>@item.Name</li>
        }
    </ul>
}